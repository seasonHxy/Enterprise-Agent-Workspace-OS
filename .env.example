VITE_DEMO_MODE=true

# Frontend only talks to the trusted bridge. Never put LETTA_API_KEY in a VITE_* variable.
VITE_MEMORY_API_URL=http://127.0.0.1:8787

# Optional enterprise control plane. Leave unset to keep the personal/local demo behavior.
VITE_ENTERPRISE_API_URL=http://127.0.0.1:8788
ENTERPRISE_GATEWAY_PORT=8788
AWOS_ENTERPRISE_AUTH_MODE=demo
AWOS_TENANT_ID=tenant-demo
AWOS_ORGANIZATION_NAME=Acme Knowledge Operations

# Production: put an identity-aware proxy in front of the gateway, switch to `proxy`,
# and let the proxy inject a short-lived signed identity assertion. Never expose this secret to Vite.
# AWOS_ENTERPRISE_AUTH_MODE=proxy
# AWOS_IDENTITY_HMAC_SECRET=replace-with-at-least-32-random-characters

# Optional REST adapter for Elasticsearch, OpenSearch, a RAG service, or an internal search API.
# ENTERPRISE_KNOWLEDGE_SEARCH_URL=https://knowledge.internal.example.com/search
# ENTERPRISE_KNOWLEDGE_TOKEN=server-side-token

# Used by `npm run memory:server`.
MEMORY_BRIDGE_PORT=8787
AWOS_ORIGIN=http://localhost:4173
LETTA_AGENT_ID=agent-your-agent-id
# LETTA_API_KEY=your-server-side-key
# LETTA_BASE_URL=http://localhost:8283
